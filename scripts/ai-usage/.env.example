# AI Usage Tracking (Slack only) – copy to .env and fill in (do not commit .env)

# Manus – https://manus.im/app?show_settings=integrations&app_name=api
MANUS_API_KEY=

# Cursor Admin API – cursor.com/dashboard → Settings → Advanced → Admin API Keys (Enterprise)
CURSOR_API_KEY=

# Anthropic – Usage/Cost API (platform.anthropic.com or docs.anthropic.com)
ANTHROPIC_API_KEY=

# OpenAI – Organization Admin API key for usage (platform.openai.com)
OPENAI_ADMIN_API_KEY=

# Slack – Incoming Webhook URL for the channel where reports are posted
SLACK_WEBHOOK_URL=

# Optional: dedicated webhook for AI usage (else uses SLACK_WEBHOOK_URL)
# SLACK_AI_USAGE_WEBHOOK_URL=
